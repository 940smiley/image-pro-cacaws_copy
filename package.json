{
  "name": "image-pro",
  "private": true,
  "version": "1.0.0",
  "description": "Image Pro - Advanced image processing and analysis application",
  "author": "940smiley",
  "type": "module",
  "main": "dist_electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "setup": "bash scripts/setup-dev-environment.sh",
    "setup:win": "scripts/setup-dev-environment.bat",
    "build:all": "bash scripts/build-and-release.sh",
    "build:all:win": "scripts/build-and-release.bat",
    "test": "npm run typecheck && npm run lint",
    "release": "bash scripts/build-and-release.sh",
    "electron:dev": "tsc -p tsconfig.electron.json && electron dist_electron/main.js",
    "electron:build": "tsc -p tsconfig.electron.json",
    "build:electron": "npm run build && npm run electron:build && electron-builder",
    "dist": "npm run build && npm run electron:build && electron-builder --publish=never",
    "tauri": "tauri"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "exiftool-vendored": "^37.2.0",
    "framer-motion": "^13.1.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.35.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.4",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.11.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.1.18",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2"
  },
  "build": {
    "appId": "com.940smiley.imagepro",
    "productName": "Image Pro",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "dist_electron/**/*"
    ],
    "extraResources": [
      "public/**/*"
    ]
  }
}
